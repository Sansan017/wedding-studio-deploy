# ==============================================================================
# Wedding Studio Free — Environment Variables Configuration Template
# ==============================================================================
# CATATAN KEAMANAN:
# Jangan pernah menyimpan nilai token rahasia, password, atau service key asli di file ini
# atau mengunggah file .env ke repository publik. Isi nilai variabel di menu Settings /
# Environment Variables pada dashboard penyedia hosting Anda (Render, Railway, Koyeb, dll).
# ==============================================================================

# 1. RUNTIME & SERVER
# Port tempat aplikasi Node.js mendengarkan koneksi (diisi otomatis oleh sebagian besar hosting)
PORT=3000

# Mode runtime aplikasi (isi 'production' pada lingkungan hosting publik)
NODE_ENV=production

# URL domain publik aplikasi Anda (contoh: https://undangan-saya.onrender.com)
# Digunakan untuk pembentukan tautan 'Bagikan ke WhatsApp' yang akurat
VITE_PUBLIC_APP_URL=https://undangan-saya.onrender.com

# 2. SUPABASE POSTGRESQL DATABASE
# Connection String PostgreSQL dari Supabase (Project Settings > Database > Connection string > URI / Transaction Pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.example:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# (Opsional) Alias alternatif untuk DATABASE_URL jika diperlukan
SUPABASE_DATABASE_URL=

# (Opsional) Mode fallback SQLite lokal jika tidak menggunakan PostgreSQL eksternal ('sqlite' atau 'postgres')
DATABASE_PROVIDER=postgres

# 3. SUPABASE CLOUD STORAGE (Bucket: wedding-photos)
# URL project Supabase Anda (Project Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Service Role Key Supabase (Project Settings > API > Project API keys > service_role)
# PENTING: Wajib menggunakan service_role key agar server backend dapat mengunggah file media
# ke bucket 'wedding-photos' dengan hak akses penuh dan aman.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Nama bucket penyimpanan foto undangan (Wajib: wedding-photos)
SUPABASE_MEDIA_BUCKET=wedding-photos

# 4. OPTIONAL AI SERVICES
# API Key untuk layanan Gemini (opsional, jika fitur AI diaktifkan)
GEMINI_API_KEY=
